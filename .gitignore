# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# load-test run artifacts
/load-test/join-log.txt
/load-test/players.json

# raw course source PDFs/images downloaded from srimadbhagavatamcourse.org —
# large binaries, not the deliverable; scripts/build_course_catalog.py's
# output (content/course-notes/, src/data/courseCatalog.json) is what's
# committed. See course-materials/README.md to re-download and rebuild.
/course-materials/raw/

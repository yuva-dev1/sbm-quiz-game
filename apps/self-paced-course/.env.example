# Local dev only — production values are injected as Cloud Run env vars / secrets.

# JSON blob: {"url": "https://script.google.com/macros/s/.../exec", "apiKey": "..."}
# Matches the SELF_PACED_SHEETS_ENDPOINT secret in Secret Manager.
SELF_PACED_SHEETS_ENDPOINT=

# Squarespace Developer API key with the Profiles (read) scope. Used to
# resolve a member's email + name from the siteUserId the course page passes.
SQUARESPACE_API_KEY=

# Signs the /host passcode cookie. Generate with: openssl rand -hex 32
SELF_PACED_SESSION_SECRET=

# Shared passcode for the /host area.
HOST_PASSCODE=

# Shared bearer token for srimad-bhagavatham-quiz-game's POST /generate-quiz.
GENERATE_QUIZ_API_KEY=

# Defaults to the deployed Kahoot app's Cloud Run URL; override for local testing.
UPSTREAM_QUIZ_URL=https://sbm-quiz-game-876193044983.us-central1.run.app/generate-quiz

PORT=8080

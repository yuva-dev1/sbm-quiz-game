# Copy to .env.local (dev) and fill in real values. Never commit real secrets.

# Local Postgres, matches docker-compose.yml defaults.
DATABASE_URL="postgresql://quiz:quiz@localhost:5432/quiz_dev?schema=public"

# Local Redis, matches docker-compose.yml defaults.
REDIS_URL="redis://localhost:6379"

# Points src/lib/firestore.ts (Admin SDK, server) at the local Firestore
# emulator (`npm run emulators:up`) instead of real Firestore. Unset in
# production — the Admin SDK picks up real credentials from the deployment
# environment.
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Realtime transport for live sessions is a Firestore listener on the client
# (src/lib/firebaseClient.ts), so the browser needs a Firebase *web app*
# config. These are NOT secrets — they identify the project; access is gated
# by firestore.rules. From the Firebase console: Project settings → your apps
# → Web app → SDK setup and configuration. NEXT_PUBLIC_* values are inlined
# at build time (see Dockerfile), so in prod they must be set as Cloud Run
# build env vars, not just runtime.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID="namabiksha-v1"
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Points the browser Firestore client at the local emulator too (dev/e2e).
# Same host:port as FIRESTORE_EMULATOR_HOST above; unset in production.
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Base URL used to build shareable join links (e.g. http://localhost:3000 in dev).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- LLM backend for quiz generation -------------------------------------
# One switch. Unset => "local" (the default): every generation call AND
# every judge (faithfulness / answerable / difficulty-match) hits the
# self-hosted OpenAI-compatible endpoint below, using LLM_MODEL. The
# OpenRouter code path is unreachable in this mode and there is NO automatic
# fallback to it — a failed call is only retried against the same endpoint.
# Set to "openrouter" to opt into the hosted path instead (gpt-4o-mini
# primary + gemini-2.5-flash fallback, judges on OpenRouter).
# See docs/self-hosted-llm.md.
LLM_BACKEND="local"

# Self-hosted endpoint (used when LLM_BACKEND=local). Origin + base path;
# "/chat/completions" is appended. LLM_BASE_URL and LLM_MODEL have built-in
# defaults (shown here); LLM_API_KEY is a secret with no default and must be
# set — locally here, in prod as a Cloud Run secret. Never commit the token.
LLM_BASE_URL="https://llm-box.tailc146aa.ts.net/v1"
LLM_API_KEY=""
LLM_MODEL="qwen3-4b-local"
# Per-request timeout (ms). A local 4B model on one GPU is far slower than a
# hosted API — 30s is not enough. Default 180000.
LLM_TIMEOUT_MS="180000"
# Parallel model calls per generation. One GPU handles ~3; OpenRouter mode
# ignores these and uses 32 / 16. Defaults 3 / 3.
LLM_CONCURRENCY="3"
LLM_TOPUP_CONCURRENCY="3"

# Used only when LLM_BACKEND=openrouter. Get a key at
# https://openrouter.ai/keys. The model slugs are optional (these are the
# built-in defaults): primary first, fallback if a slot still fails after a
# repair retry.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL_PRIMARY="openai/gpt-4o-mini"
OPENROUTER_MODEL_FALLBACK="google/gemini-2.5-flash"

# Shared bearer token other backend services must send
# (Authorization: Bearer <token>) to call this app's own POST /generate-quiz
# endpoint. Generate with: openssl rand -base64 32
GENERATE_QUIZ_API_KEY=""

# Shared passcode the host enters at /host/login to access the host pages.
HOST_PASSCODE=""

# Random secret used to sign the host's session cookie. Generate with:
# openssl rand -base64 32
SESSION_SECRET=""

# Optional: only needed if the target Postgres server's `template1` isn't
# pristine (e.g. it doubles as the app's own database), which would
# otherwise leak existing objects into Prisma's auto-created shadow database
# used by `prisma migrate dev`.
SHADOW_DATABASE_URL=""
